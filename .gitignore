# UccML: study notes, Python practice, and Obsidian vault

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

.idea/
.vscode/
*.code-workspace

# ---------------------------------------------------------------------------
# Obsidian
# Keep notes as Markdown. Ignore local workspace/cache state.
# If you want to sync themes/plugins/hotkeys through Git later, remove the
# relevant lines below.
# ---------------------------------------------------------------------------
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/cache/
**/.obsidian/plugins/*/data.json
**/.obsidian/trash/
**/.trash/

# ---------------------------------------------------------------------------
# Python bytecode and caches
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.cache/

# ---------------------------------------------------------------------------
# Python environments and local config
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
.venv/
venv/
env/
ENV/
conda-meta/
__pypackages__/
.python-version

# ---------------------------------------------------------------------------
# Packaging / build artifacts
# ---------------------------------------------------------------------------
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/
pip-wheel-metadata/
MANIFEST

# ---------------------------------------------------------------------------
# Jupyter / notebooks
# Keep notebooks trackable if you decide to save study notebooks.
# Ignore only checkpoint noise.
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Logs, reports, and temporary outputs
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp

htmlcov/
.coverage
.coverage.*
coverage.xml
cover/

# ---------------------------------------------------------------------------
# ML experiment outputs
# ---------------------------------------------------------------------------
runs/
outputs/
results/
figures/generated/
wandb/
mlruns/
lightning_logs/
tensorboard/

checkpoints/
ckpts/
models/
weights/
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.pkl
*.pickle
*.joblib

# ---------------------------------------------------------------------------
# Large data files
# Keep small toy data trackable. Put large/raw datasets under ignored folders.
# ---------------------------------------------------------------------------
data/raw/
data/external/
data/interim/
data/processed/

*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.npy
*.npz
*.mat
*.jsonl

!data/toy/
!data/toy/**

# ---------------------------------------------------------------------------
# Archives and compressed downloads
# ---------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.gz

# ---------------------------------------------------------------------------
# Documents and attachments
# Markdown notes are tracked; large PDFs/images are better kept selective.
# Uncomment the PDF line if you do not want papers committed.
# ---------------------------------------------------------------------------
# *.pdf
